{
  "name": "fabric0de",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "game:preview": "tsx ./scripts/game/run.ts",
    "game:update": "tsx ./scripts/game/run.ts",
    "game:simulate": "tsx ./scripts/game/simulate.ts",
    "creature:grow": "tsx ./scripts/game/run.ts --images",
    "test": "npm run test:game",
    "test:game": "tsx --test ./scripts/game/*.test.ts",
    "build": "tsc",
    "format": "prettier --write \"scripts/**/*.{ts,js}\"",
    "format:check": "prettier --check \"scripts/**/*.{ts,js}\"",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "sharp": "^0.35.4"
  }
}
